            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          }
        },
        "required": [
          "id",
          "title",
          "times",
          "startDate"
        ],
        "description": "A recurring care need with a schedule."
      },
      "description": "Recurring task definitions. Use [] if none."
    }
  },
  "required": [
    "format",
    "version",
    "exportedAt",
    "patient",
    "entries",
    "tasks"
  ],
  "description": "One patient with profile, timeline entries and recurring tasks. India-first: IST (+05:30), mg/dL, °F, kg, cm, +91. Not expressible in JSON Schema (the app also checks): entry ids unique; task ids unique; every task entry taskId matches a tasks[].id. Agent guide: ../agent/AGENTS.md",
  "$id": "medasium.schema.json",
  "title": "Medasium patient import/export file"
