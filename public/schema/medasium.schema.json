            "if": {
              "properties": {
                "outcome": {
                  "const": "skipped"
                }
              },
              "required": [
                "outcome"
              ]
            },
            "then": {
              "required": [
                "reason"
              ],
              "properties": {
                "reason": {
                  "minLength": 1
