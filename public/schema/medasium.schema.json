    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "Unique within the file. UUID recommended; any short unique string such as \"e_001\" is accepted. Used to match records on merge."
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "e.g. \"Turn patient\", \"Physiotherapy\", \"Dressing change\"."
